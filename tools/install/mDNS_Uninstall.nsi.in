# mDNS_Uninstall.nsi
#
# Do not edit mDNS_Uninstall.nsi, edit mDNS_Uninstall.nsi.in
#
# Create the Windows uninstaller for mDNS
#
# Usage: "C:\Program Files (x86)\NSIS\makensis.exe" mDNS_Uninstall.nsi

!include "WinVer.nsh"
!include "WordFunc.nsh"
!include "Registry.nsh"

# ; MUI 1.67 compatible ------
!include "MUI.nsh"

# ; MUI Settings
!define MUI_ABORTWARNING
!define MUI_UNICON "ETCIconDark_NSIS.ico"
!insertmacro MUI_UNPAGE_WELCOME
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_UNPAGE_FINISH
!insertmacro MUI_LANGUAGE "English"
# MUI end ------

!ifndef ARTIFACT_TYPE
  !define ARTIFACT_TYPE 86
!endif

!define PRODUCT_NAME "ETC DNS-SD Service x${ARTIFACT_TYPE}"
!define UNINSTALL_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall{8A23B836-C37F-4EB7-9EA9-4CAD5E5EAABF}"
!define PRODUCT_VERSION "@VERSION@"

# the name of the uninstaller
Outfile "mDNS_Fake_Install.exe"

# Request application privileges for Windows Vista
RequestExecutionLevel admin

# define the friendly name displayed in the installer pages
Name "${PRODUCT_NAME} ${PRODUCT_VERSION}"

# Show install details
ShowInstDetails show

# default section
Section Uninstall
  # this will affect all users
  SetShellVarContext all

  DetailPrint "Stopping ETC DNS-SD Service"
  DetailPrint "$SYSDIR\sc.exe stop ETC DNS-SD Service"
  ExecWait '$SYSDIR\sc.exe stop "ETC DNS-SD Service"'

  DetailPrint "Deleting ETC DNS-SD Service"
  DetailPrint "$SYSDIR\sc.exe delete ETC DNS-SD Service"
  ExecWait '$SYSDIR\sc.exe delete "ETC DNS-SD Service"'

  Delete "$PROGRAMFILES\ETC\DNS-SD\mDNSResponder.exe"

  DetailPrint "Removing Firewall Exception"
  ExecWait 'netsh advfirewall firewall delete rule name="ETC DNS-SD Service (TCP-in)"'
  ExecWait 'netsh advfirewall firewall delete rule name="ETC DNS-SD Service (UDP-in)"'

  # delete keys used by Control Panel "Uninstall" screen
  DeleteRegKey HKLM "${UNINSTALL_KEY}"

  SetOutPath "$PROGRAMFILES\ETC\DNS-SD"

  # finally, delete the uninstaller itself
  Delete "$PROGRAMFILES\ETC\DNS-SD\mDNS_Uninstall.exe"

  RMDir "$PROGRAMFILES\ETC\DNS-SD"
  RMDir "$PROGRAMFILES\ETC"

  SetAutoClose true
SectionEnd

Section "Application"
  # only "install" the uninstaller
  SetOutPath "$PROGRAMFILES\ETC\DNS-SD"
  WriteUninstaller "$EXEDIR\mDNS_Uninstall.exe"
SectionEnd
